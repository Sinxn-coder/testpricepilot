# --- SERVER CONFIGURATION ---
PORT=8080
NODE_ENV=production

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- FIREBASE CONFIGURATION ---
FIREBASE_PROJECT_ID=pricepilot-project
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Alternative for hosts that support JSON string secrets:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- PRICING ENGINE (INTERNAL) ---
PRICING_ENGINE_URL=https://engine.pricepilot.site
PRICING_ENGINE_API_KEY=pp_engine_secret_key_here
PRICING_ENGINE_TIMEOUT_MS=500

# --- FRONTEND & CORS ---
CORS_ALLOWED_ORIGINS=https://pricepilot.site,http://localhost:8080
API_BASE_URL=https://api.pricepilot.site

# --- PERFORMANCE & CACHE ---
CACHE_TTL_SECONDS=120
